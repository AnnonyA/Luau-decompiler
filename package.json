{
  "name": "luau-decompiler",
  "version": "0.2.0",
  "description": "Semantically faithful Luau bytecode decompiler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "luau-decompile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "demo:test": "node --test scripts/demo.test.mjs",
    "demo:test:browser": "node --test scripts/demo-browser.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:compare": "node scripts/bench-compare.mjs",
    "bench:semantic": "node scripts/bench-semantic.mjs",
    "bench:test": "node --test scripts/bench-compare.test.mjs scripts/bench-summary.test.mjs scripts/bench-assert-syntax.test.mjs scripts/bench-semantic.test.mjs",
    "serve": "node dist/cli.js serve"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
