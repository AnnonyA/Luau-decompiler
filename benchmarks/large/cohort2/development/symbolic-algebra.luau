families[1] = function(context)
    local a = constant(1 + math.abs(seed % 3) / 10)
    local b = constant(2 + mode / 10)
    local c = constant(1 + (seed % 7) / 20)
    local expression = (a * x + b * y + c) ^ 2 + z
    local tags = {"affine_energy", "family-0", "analytic"}
    local weight = 1 + mode / 5
    if (seed + 0) % 3 == 0 then
        expression = expression + (x - x) * y
        table.insert(tags, "cancellation")
    elseif (seed + 0) % 3 == 1 then
        expression = expression * 1 + 0
        table.insert(tags, "identity")
    else
        expression = -(-expression)
        table.insert(tags, "involution")
    end
    local summary, canonical = record("affine_energy", expression, context, weight, tags)
    local direction = derivative(canonical, "x") + derivative(canonical, "y")
    local directionRun = evaluator(simplify(direction))
    local directionalValue = directionRun(context)
    local curve = taylor(canonical, context, 0.5, 2)
    local predicted = curve:evaluate(context.x - 0.5)
    local residual = summary.value - predicted
    local curvatureRun = evaluator(derivative(derivative(canonical, "x"), "x"))
    local curvature = curvatureRun(context)
    summary.direction = directionalValue
    summary.curvature = curvature
    summary.residual = residual
    print("analysis", "affine_energy", rounded(directionalValue), rounded(curvature), curve:describe(), rounded(residual))
    return canonical, summary
end

