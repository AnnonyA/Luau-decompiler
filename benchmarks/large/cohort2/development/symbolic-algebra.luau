local checksum = 0
table.sort(records, function(a, b)
    if a.operations == b.operations then
        return a.name < b.name
    end
    return a.operations < b.operations
end)
for rank, entry in ipairs(records) do
    checksum += entry.weight * (entry.value + entry.slope + entry.area + entry.curvature / 10)
    print("rank", rank, entry.name, entry.operations, rounded(entry.residual))
end
local function expectError(label, callback)
    local ok, result = pcall(callback)
    assert(not ok, "missing expected error")
    print("caught", label, tostring(result))
end
expectError("missing", function()
    local run = evaluator(x + y)
    return run({x = 1})
end)
expectError("domain", function()
    local run = evaluator(log(x))
    return run({x = -1})
end)
expectError("division", function()
    local run = evaluator(x / y)
    return run({x = 1, y = 0})
end)
expectError("duplicate", function()
    return interpolate({{1, 2}, {1, 3}})
end)
print("stats", stats.created, stats.reused, stats.reduced, stats.differentiated, stats.evaluated)
print("checksum", rounded(checksum), #records, #canonicalExpressions)
