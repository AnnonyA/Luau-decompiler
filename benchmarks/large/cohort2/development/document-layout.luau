builders[1] = function(context)
    local children = {}
    local identifier = "section-1"
    local heading = documentNode("heading", {style = "section", anchor = identifier, level = 1}, {textNode("The Atlas of Small Systems")})
    table.insert(children, heading)
    local content = "A document records decisions through geometry. Each line carries a measured sequence of words and each page offers a finite area for those decisions."
    content = content .. " Survey " .. tostring(context.sequence + 0) .. " uses mode " .. tostring(mode) .. "."
    local attributes = {style = "title", compact = (0 + mode) % 3 == 0, emphasis = (0 + seed) % 5 == 0, muted = (0 + mode) % 7 == 0}
    table.insert(children, paragraph(content, attributes))
    if (0 + seed) % 4 == 0 then
        table.insert(children, documentNode("rule", {thickness = 1/2}))
    end
    if 0 % 5 == mode % 5 then
        table.insert(children, documentNode("footnote", {name = "note-1"}, {textNode("The Atlas of Small Systems provides a cross check for the measured reading order.")}))
    end
    local target = "section-8"
    table.insert(children, documentNode("reference", {target = target}))
    if (0 + mode) % 6 == 0 then
        table.insert(children, documentNode("box", {label = "figure-1", height = 18, style = "caption"}))
    end
    context.sequence += 1
    return documentNode("section", {overrides = {tracking = (0%2) / 20}}, children)
end

