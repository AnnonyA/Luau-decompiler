local function buildDocument()
    local context = {sequence = math.abs(seed) + 1}
    local children = {}
    table.insert(children, documentNode("heading", {style = "title", anchor = "opening", level = 0}, {textNode("A Deterministic Field Atlas")}))
    table.insert(children, paragraph("An experiment in measured words, inherited styles, and connected pages.", {style = "subtitle"}))
    for index, builder in ipairs(builders) do
        table.insert(children, builder(context))
        if index % 7 == 0 then
            local rows = {{"Station", "Measure", "Status"}}
            for row = 1, 3 + mode % 2 do
                local value = (seed + index * row) % 97
                table.insert(rows, {"S" .. tostring(index) .. "." .. tostring(row), tostring(value) .. " units", value % 2 == 0 and "verified" or "pending"})
            end
            table.insert(children, documentNode("table", {rows = rows, style = "body"}))
        end
        if index == 14 and mode % 2 == 1 then
            table.insert(children, documentNode("pagebreak"))
        end
    end
    table.insert(children, documentNode("reference", {target = "opening"}))
    table.insert(children, documentNode("reference", {target = "unwritten-appendix"}))
    return documentNode("document", {}, children)
end
local function outline(current, depth, counts)
    counts[current.kind] = (counts[current.kind] or 0) + 1
    local maximum = depth
    for _, child in ipairs(current.children) do
        maximum = math.max(maximum, outline(child, depth + 1, counts))
    end
    return maximum
end
local function hitTest(engine, pageNumber, x, y)
    local page = engine.pages[pageNumber]
    if not page then
        return "outside-page"
    end
    for index = #page.commands, 1, -1 do
        local command = page.commands[index]
        local height = command.height or command.size or 10
        if x >= command.x and x <= command.x + (command.width or 0) and y >= command.y and y <= command.y + height then
            return command.kind .. ":" .. (command.text or command.color or "")
        end
    end
    return "margin"
end
local document = buildDocument()
local configuration = {
    width = 360 + (seed % 3) * 20,
    height = 310 + (mode % 3) * 30,
    margin = 18 + seed % 4,
    gutter = 14,
    columns = 1 + mode % 2,
}
print("layout", seed, mode, configuration.width, configuration.height, configuration.columns)
local counts = {}
local depth = outline(document, 0, counts)
local kinds = {}
for kind in pairs(counts) do
    table.insert(kinds, kind)
end
table.sort(kinds)
for _, kind in ipairs(kinds) do
    print("NODE", kind, counts[kind])
end
print("TREE", depth, serial)
