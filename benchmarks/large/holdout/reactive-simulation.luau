local names = { "harvest", "refine", "transport", "charge", "cool", "repair", "trade", "research", "irrigate", "mine", "fabricate", "recycle", "allocate", "forecast", "inspect", "route", "store", "consume", "tax", "insure" }
local world = makeWorld()
for index = 1, #names do
    local name = names[index]
    world.handlers[name] = handlerFactories[name](world)
end
world.handlers.report = function(tx, entity, payload)
    local stability, version = world.graph:read("stability")
    tx:effect("report", payload.source, stability, version)
    entity.status = stability < 0 and "alert" or "steady"
    return stability, version
end
local function installWatch(name, threshold)
    local changes = 0
    local last = world.graph:read(name)
    local unsubscribe
    unsubscribe = world.graph:watch(name, function(value, old, source)
        changes += 1
        local difference = value - last
        last = value
        emit("watch", source, old, value, changes, difference)
        if math.abs(difference) >= threshold and world.watchBudget > 0 then
            world.watchBudget -= 1
            schedule(world, "report", world.tick + 1, changes % #world.entities + 1, { source = source }, 1)
        end
        if changes == 18 then
            emit("unsubscribe", source, unsubscribe())
        end
    end)
    return function()
        return changes, last
    end
end
local readStability = installWatch("stability", 4)
local readPressure = installWatch("pressure", 3)
local readResilience = installWatch("resilience", 2)
world.graph:flush()
emit("reactive-simulation", seed, mode)
for tick = 1, 4 do
    for index = 1, #names do
        local entity = (index + tick + mode) % #world.entities + 1
        local amount = (index * 3 + tick + seed) % 13 + 1
        local abort = seed < 0 and tick == 2 and index % 7 == 0
        local sequence = schedule(world, names[index], tick * 3, entity, { amount = amount, abort = abort }, index % 5 + 2)
        if mode == 4 and tick == 3 and index % 9 == 0 then
            world.cancelled[sequence] = true
        end
    end
end
local maxQueue = world.queue:validate()
while #world.queue.data > 0 do
    local event = world.queue:pop()
    world.tick = event.tick
    if world.cancelled[event.sequence] then
        world.metrics.rejected += 1
        emit("cancel", event.sequence, event.kind)
    else
        applyEvent(world, event)
    end
    if world.handled > 140 then
        fault("EVENT_LIMIT", world.handled)
    end
    maxQueue = math.max(maxQueue, world.queue:validate())
end
local function nestedFold(value, depth)
    if type(value) == "number" then
        return value * (depth + 1), 1
    elseif type(value) ~= "table" then
        return #tostring(value), 1
    end
    local total = 0
    local leaves = 0
    for index = 1, #value do
        local part, count = nestedFold(value[index], depth + 1)
        total = (total + part * index) % 1000003
        leaves += count
    end
    return total, leaves
end
local resourceDigest = 0
for index = 1, #world.graph.order do
    local name = world.graph.order[index]
    local value, version = world.graph:read(name)
    resourceDigest = (resourceDigest * 17 + value + version * index) % 1000003
    emit("resource", name, value, version)
end
local entityDigest = 0
for index = 1, #world.entities do
    local entity = world.entities[index]
    local history, leaves = nestedFold(entity.history, 1)
    local cost, stops = routeCost(entity.route, 1, {})
    entityDigest = (entityDigest + history + entity.position:length() * 13 + entity.fatigue * 7 + cost) % 1000003
    emit("entity", entity.id, entity.position.x, entity.position.y, entity.cargo.amount, entity.cargo.kind, entity.status, entity.visits, history, leaves, cost, stops)
end
local ledgerDigest = 0
for index = 1, #world.ledger do
    local entry = world.ledger[index]
    local folded, leaves = nestedFold(entry[4], 1)
    ledgerDigest = (ledgerDigest * 11 + folded + leaves + entry[1]) % 1000003
    emit("ledger", entry[1], entry[2], entry[3], folded, leaves)
end
local receiptDigest = 0
for index = 1, #world.receipts do
    local receipt = world.receipts[index]
    receiptDigest = (receiptDigest * 3 + receipt[1] + receipt[3] + (receipt[2] and 7 or 0)) % 1000003
end
local function probe(label, callback, ...)
    local args = pack(...)
    local result = pack(pcall(function()
        return callback(table.unpack(args, 1, args.n))
    end))
    emit("probe", label, result[1], result[2], result[3])
end
probe("missing", function(name)
    return world.graph:read(name)
end, "unregistered")
probe("readonly", function(name, value)
    local tx = Transaction.new(world, "probe")
    tx:write(name, value)
    return tx:validate()
end, "stability", 5)
probe("negative", function(value)
    local tx = Transaction.new(world, "probe")
    tx:write("food", value)
    return tx:validate()
end, -1)
probe("closed", function()
    local tx = Transaction.new(world, "probe")
    tx:commit()
    tx:add("water", 1)
end)
probe("cycle", function()
    local graph = Graph.new()
    graph:add("base", 1)
    graph:add("recursive", 0, { "base" }, function(value)
        return value + graph:read("recursive")
    end)
    return graph:read("recursive")
end)
probe("multiret", function(a, b, ...)
    return a + select("#", ...), b
end, seed, mode, nil, 4, nil)
local stabilityChanges, stabilityLast = readStability()
local pressureChanges, pressureLast = readPressure()
local resilienceChanges, resilienceLast = readResilience()
emit("observers", stabilityChanges, stabilityLast, pressureChanges, pressureLast, resilienceChanges, resilienceLast)
emit("metrics", world.metrics.produced, world.metrics.notifications, world.metrics.rejected, maxQueue)
emit("total", world.handled, world.commits, world.rollbacks, resourceDigest, entityDigest, ledgerDigest, receiptDigest)
for index = 1, #trace do
    print(trace[index])
end
