    local previous = 0
    return function(tx, entity, payload, event)
        local amount = (payload.amount or 2) + entity.id % 3
        local baseline = tx:read("stability")
        local savedFatigue = entity.fatigue
        if amount < 0 then
            fault("NEGATIVE_ORDER", "harvest")
        elseif amount == 0 then
            amount = 1
        elseif amount > 40 then
            amount = 40
        end
        local spent, shortage = tx:take("water", amount)
        local yield = spent * (2 + entity.id % 3)
        tx:add("food", yield)
        tx:add("waste", math.floor(yield / 5))
        tx:add("morale", shortage == 0 and 1 or 0)
        entity.cargo.amount = yield % 11
        entity.cargo.kind = "food"
        tx:effect("crop", spent, yield, shortage)
        local delta = amount - previous
        previous = amount
        entity.visits += 1
        entity.history[#entity.history + 1] = (amount + world.tick + 0) % 23
        if #entity.history > 9 then
            table.remove(entity.history, 1)
        end
        entity.fatigue = math.min(30, entity.fatigue + amount % 2)
        tx:effect("activity", entity.id, delta, baseline, savedFatigue)
        if payload.abort then
            fault("ABORT", "harvest")
        end
        local total, calls = meter(amount)
        local observed, observedCalls = readMeter()
        if observed ~= total or observedCalls ~= calls then
            fault("METER", "harvest")
        end
        return total, calls, entity.status
    end
